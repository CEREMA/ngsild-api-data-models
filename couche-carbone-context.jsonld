{
    "@context": {
        "mob": "https://semantics.cerema.fr/ontologies/mobilites/",
        "igeo": "http://rdf.insee.fr/def/geo#",
        "dct": "http://purl.org/dc/terms/",

        "VehicleStock": "mob:VehicleStock",
            "spatial": "dct:spatial",
            "vehicleCount": "mob:vehicleCount",
            "vehicleGroup": "mob:vehicleGroup",
            "fuelType": "mob:fuelType",
            "totalVehicleCount": "mob:totalVehicleCount",
            "vehicleCountByFuelType": "mob:vehicleTypeByType",
            "vehicleCountByGroup": "mob:vehicleTypeByGroup",
            "electrifiedShare": "mob:electrifiedShare",
            "source": "dct:source",

        "RoadSegmentAADT": "mob:RoadSegmentAADT",
            "roadIdBdTopo": "mob:roadIdBdTopo",
            "aadt": "mob:aadt",
            "spdLimit": "https://semantics.cerema.fr/ontologies/trafic/spdLimit",
            "aadtSource": "mob:aadtSource",
            "composedOf": "mob:composedOf",
            "pcentPl": "mob:pcentPl",
            "geometry": "https://uri.etsi.org/ngsi-ld/location",

        "Commune": "igeo:Commune",
        "codeInsee": "igeo:codeCommune",

        "VUL": "mob:VUL",
        "Diesel": "mob:Diesel"
    }
}
